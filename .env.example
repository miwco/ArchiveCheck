# Copy this file to ".env" and fill in what you have. All values are optional —
# the tool degrades gracefully when a key or binary is missing (run
# `py -m archivecheck --check` to see current capability).

# Free AcoustID key for song identification: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Anthropic key for cleaner credit role/name structuring (else a heuristic is used).
# Get one at https://console.anthropic.com -> Settings -> API Keys (pay-as-you-go,
# billed separately from any Claude subscription). Each user supplies their own key.
ANTHROPIC_API_KEY=

# Model for credit structuring. Default is the cheap, fast claude-haiku-4-5
# (~1 cent/film). Set to claude-opus-4-8 for maximum quality at higher cost.
# ANTHROPIC_MODEL=claude-haiku-4-5

# Optional explicit paths to external binaries (otherwise found on PATH).
# Each may point at the binary itself or the folder containing it.
# FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# FPCALC=C:\tools\chromaprint\fpcalc.exe
# TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional default output root (overridden by -o/--output on the CLI)
# VC_OUTPUT_ROOT=C:\archivecheck_output

# ---------------------------------------------------------------------------
# Web app (web.app) — only needed when running the server, not the CLI.
# ---------------------------------------------------------------------------
# Shared access code users type to sign in (pilot auth; OAuth comes later).
VC_ACCESS_CODE=change-me
# Secret for signing session cookies — set a long random value in production.
VC_SESSION_SECRET=change-me-to-a-long-random-string

# Limits / cost control (server-enforced; these are the defaults).
# VC_MODEL=claude-haiku-4-5          # model is locked server-side; never client-set
# VC_MAX_DURATION_SEC=1200           # refuse videos longer than 20 min
# VC_MAX_PER_DAY=20                  # analyses per session per day
# VC_MIN_INTERVAL_SEC=10             # min seconds between submissions
# VC_MAX_COST_PER_VIDEO=0.05
# VC_MAX_COST_PER_SESSION=1.0
# VC_MAX_CONCURRENT=1               # worker threads (each ~2 GB RAM)
# VC_DATA_DIR=web_data              # SQLite + cached results live here
# VC_RETENTION_DAYS=30
