# Copy this file to ".env" and fill in what you have. All values are optional —
# the tool degrades gracefully when a key or binary is missing (run
# `py -m archivecheck --check` to see current capability).

# Free AcoustID key for song identification: https://acoustid.org/new-application
ACOUSTID_API_KEY=

# Anthropic key for cleaner credit role/name structuring (else a heuristic is used)
ANTHROPIC_API_KEY=

# Optional explicit paths to external binaries (otherwise found on PATH).
# Each may point at the binary itself or the folder containing it.
# FFMPEG=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE=C:\ffmpeg\bin\ffprobe.exe
# FPCALC=C:\tools\chromaprint\fpcalc.exe
# TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional default output root (overridden by -o/--output on the CLI)
# VC_OUTPUT_ROOT=C:\archivecheck_output
